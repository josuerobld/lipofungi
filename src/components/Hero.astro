---
import { asset } from '../lib/paths';
---

<section
  id="inicio"
  class="relative flex min-h-screen items-center overflow-hidden bg-[var(--color-bosque)] pt-28 pb-16"
>
  <!-- Fondo decorativo: esporas / burbujas -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div
      class="absolute -top-24 -left-24 h-96 w-96 rounded-full bg-[var(--color-oliva)]/20 blur-3xl animate-float-slow"
    >
    </div>
    <div
      class="absolute top-1/3 -right-20 h-80 w-80 rounded-full bg-[var(--color-savia)]/15 blur-3xl animate-float"
    >
    </div>
    <div
      class="absolute bottom-0 left-1/4 h-64 w-64 rounded-full bg-[var(--color-salvia)]/10 blur-3xl animate-float-slow"
    >
    </div>
    <!-- Grid sutil -->
    <div
      class="absolute inset-0 opacity-[0.04]"
      style="background-image: linear-gradient(var(--color-salvia) 1px, transparent 1px), linear-gradient(90deg, var(--color-salvia) 1px, transparent 1px); background-size: 48px 48px;"
    >
    </div>
  </div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 md:px-8 lg:grid-cols-[1.1fr_0.9fr]">
    <!-- Columna texto -->
    <div class="text-center lg:text-left">
      <span
        class="reveal inline-flex items-center gap-2 rounded-full border border-[var(--color-savia)]/40 bg-white/5 px-4 py-2 text-xs font-bold tracking-[0.2em] text-[var(--color-savia)] uppercase backdrop-blur"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="absolute inline-flex h-full w-full rounded-full bg-[var(--color-savia)] opacity-75"
            style="animation: pulse-ring 2s cubic-bezier(0,0,0.2,1) infinite;"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-savia)]"></span>
        </span>
        LipoFungi
      </span>

      <h1
        class="reveal reveal-d1 mt-6 text-5xl font-black leading-[0.95] tracking-tight text-white sm:text-6xl md:text-7xl xl:text-[5.5rem]"
      >
        Un hongo<br />
        que <span class="text-gradient">come grasa</span>
      </h1>

      <p
        class="reveal reveal-d2 mx-auto mt-6 max-w-xl text-lg leading-relaxed text-[var(--color-salvia)] lg:mx-0 md:text-xl"
      >
        La naturaleza puede hacer trabajo complejo de una manera
        sorprendentemente simple. <strong class="font-bold text-white"
          >LipoFungi</strong
        > convierte un proceso natural en una solución fácil de entender y de reconocer.
      </p>

      <div
        class="reveal reveal-d3 mt-9 flex flex-col items-center gap-4 sm:flex-row lg:justify-start"
      >
        <a
          href="#que-somos"
          class="group inline-flex items-center gap-2 rounded-full bg-[var(--color-oliva)] px-8 py-4 text-base font-bold text-white shadow-xl shadow-black/20 transition-all duration-300 hover:-translate-y-1 hover:bg-[var(--color-savia)] hover:text-[var(--color-bosque-900)]"
        >
          Descubre cómo
          <svg
            class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
          </svg>
        </a>
        <a
          href="#precios"
          class="inline-flex items-center gap-2 rounded-full border-2 border-white/25 px-8 py-4 text-base font-bold text-white transition-all duration-300 hover:border-[var(--color-savia)] hover:bg-white/5"
        >
          Solicitar cotización
        </a>
      </div>

      <!-- Mini stats de esencia -->
      <dl
        class="reveal reveal-d4 mt-12 grid grid-cols-3 gap-4 border-t border-white/10 pt-8 text-center lg:text-left"
      >
        <div>
          <dt class="text-xs font-bold tracking-wider text-[var(--color-savia)] uppercase">Natural</dt>
          <dd class="mt-1 text-sm text-white/70">Origen orgánico y fúngico</dd>
        </div>
        <div>
          <dt class="text-xs font-bold tracking-wider text-[var(--color-savia)] uppercase">Precisa</dt>
          <dd class="mt-1 text-sm text-white/70">Beneficios sin exagerar</dd>
        </div>
        <div>
          <dt class="text-xs font-bold tracking-wider text-[var(--color-savia)] uppercase">Innovadora</dt>
          <dd class="mt-1 text-sm text-white/70">Solución poco convencional</dd>
        </div>
      </dl>
    </div>

    <!-- Columna visual: logo con halo -->
    <div class="reveal reveal-scale reveal-d2 relative mx-auto hidden lg:block">
      <div class="relative aspect-square w-full max-w-md">
        <!-- Halos concéntricos -->
        <div class="absolute inset-0 rounded-full border border-[var(--color-savia)]/20"></div>
        <div class="absolute inset-8 rounded-full border border-[var(--color-savia)]/15"></div>
        <div class="absolute inset-16 rounded-full border border-[var(--color-savia)]/10"></div>
        <div
          class="absolute inset-6 rounded-full bg-gradient-to-br from-[var(--color-oliva)]/25 to-transparent blur-2xl"
        >
        </div>
        <img
          src={asset('/logos/logo-oscuro.png')}
          alt="Isotipo de LipoFungi: un hongo estilizado con una gota de grasa"
          width="420"
          height="420"
          class="animate-float relative h-full w-full object-contain p-10 drop-shadow-2xl"
          loading="eager"
        />
      </div>
    </div>
  </div>

  <!-- Indicador scroll -->
  <a
    href="#que-somos"
    class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white/50 transition-colors hover:text-white"
    aria-label="Desplázate hacia abajo"
  >
    <svg
      class="animate-bounce-soft h-7 w-7"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="2"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
    </svg>
  </a>
</section>
