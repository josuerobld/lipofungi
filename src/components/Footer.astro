---
import { asset } from '../lib/paths';

const email = 'malejandrabarmontepeque@gmail.com';
const year = new Date().getFullYear();
const nav = [
  { href: '#que-somos', label: 'Qué somos' },
  { href: '#servicio', label: 'Servicio' },
  { href: '#validacion', label: 'Validación' },
  { href: '#precios', label: 'Precios' },
  { href: '#contacto', label: 'Contacto' },
];
---

<footer class="bg-[var(--color-carbon)] text-white">
  <div class="mx-auto max-w-7xl px-5 py-16 md:px-8">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
      <!-- Marca -->
      <div>
        <img
          src={asset('/logos/logo-oscuro.png')}
          alt="LipoFungi"
          width="170"
          height="50"
          class="h-12 w-auto"
          loading="lazy"
        />
        <p class="mt-5 max-w-xs text-[15px] leading-relaxed text-white/60">
          Biología aplicada: un hongo que convierte un proceso natural en una
          solución simple de entender y fácil de reconocer.
        </p>
      </div>

      <!-- Navegación -->
      <nav aria-label="Navegación del pie de página">
        <h3 class="text-sm font-bold tracking-wider text-[var(--color-savia)] uppercase">
          Navegación
        </h3>
        <ul class="mt-4 space-y-2.5">
          {
            nav.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-[15px] text-white/60 transition-colors hover:text-white"
                  >{l.label}</a
                >
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contacto -->
      <div>
        <h3 class="text-sm font-bold tracking-wider text-[var(--color-savia)] uppercase">
          Contacto
        </h3>
        <ul class="mt-4 space-y-2.5 text-[15px] text-white/60">
          <li>
            <a
              href={`mailto:${email}`}
              class="break-all transition-colors hover:text-white">{email}</a
            >
          </li>
          <li>Guatemala</li>
          <li>
            <a
              href="#precios"
              class="inline-block font-bold text-[var(--color-savia)] transition-colors hover:text-white"
              >Solicitar cotización →</a
            >
          </li>
        </ul>
      </div>
    </div>

    <!-- Línea inferior -->
    <div
      class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-7 sm:flex-row"
    >
      <p class="text-sm text-white/50">
        © {year} LipoFungi. Todos los derechos reservados.
      </p>
      <p class="text-sm text-white/40">
        Desarrollado por
        <a
          href="https://github.com/josuerobld"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-1.5 font-bold text-white/70 transition-colors hover:text-[var(--color-savia)]"
        >
          <svg
            class="h-4 w-4"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
            ></path>
          </svg>
          josuerobld
        </a>
      </p>
    </div>
  </div>
</footer>
