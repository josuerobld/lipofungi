---
const email = 'malejandrabarmontepeque@gmail.com';
const asunto = encodeURIComponent('Solicitud de cotización · LipoFungi');
const cuerpo = encodeURIComponent(
  'Hola, me interesa conocer más sobre LipoFungi y solicitar una cotización.\n\n' +
    'Nombre:\nEmpresa / negocio:\nUbicación:\nDescripción del caso (tipo de trampa de grasa, volumen aprox.):\n\n¡Gracias!'
);
const mailto = `mailto:${email}?subject=${asunto}&body=${cuerpo}`;

const incluye = [
  'Diagnóstico inicial de tu caso',
  'Aplicación del cultivo fúngico',
  'Acompañamiento y seguimiento del proceso',
  'Asesoría clara, sin lenguaje complicado',
  'Solución segura para ambiente y salud',
];
---

<section
  id="precios"
  class="relative overflow-hidden bg-[var(--color-salvia)]/40 py-24 md:py-32"
>
  <div class="mx-auto max-w-5xl px-5 md:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span
        class="reveal text-sm font-bold tracking-[0.25em] text-[var(--color-oliva-600)] uppercase"
        >Precios</span
      >
      <h2
        class="reveal reveal-d1 mt-4 text-4xl font-black leading-tight tracking-tight text-[var(--color-bosque)] sm:text-5xl md:text-6xl"
      >
        Hecho a la <span class="text-[var(--color-oliva)]">medida</span> de tu caso
      </h2>
      <p
        class="reveal reveal-d2 mt-6 text-lg leading-relaxed text-[var(--color-carbon)]/80"
      >
        Cada trampa de grasa es distinta. Por el momento trabajamos con
        cotizaciones personalizadas: cuéntanos tu caso y te preparamos una
        propuesta a tu medida.
      </p>
    </div>

    <!-- Tarjeta de cotización -->
    <div
      class="reveal reveal-scale mx-auto mt-14 max-w-2xl overflow-hidden rounded-3xl bg-white shadow-2xl shadow-[var(--color-bosque)]/10"
    >
      <div
        class="relative overflow-hidden bg-[var(--color-bosque)] px-8 py-10 text-center text-white md:px-12"
      >
        <div
          class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-[var(--color-oliva)]/25 blur-2xl"
          aria-hidden="true"
        >
        </div>
        <span
          class="relative inline-block rounded-full bg-[var(--color-oliva)] px-4 py-1.5 text-xs font-bold tracking-wider uppercase"
          >Cotización personalizada</span
        >
        <p class="relative mt-6 text-5xl font-black md:text-6xl">
          A tu medida
        </p>
        <p class="relative mt-3 text-[var(--color-salvia)]">
          Precio según diagnóstico y volumen
        </p>
      </div>

      <div class="px-8 py-10 md:px-12">
        <h3 class="text-sm font-bold tracking-wider text-[var(--color-oliva-600)] uppercase">
          Qué incluye
        </h3>
        <ul class="mt-5 space-y-3.5">
          {
            incluye.map((item) => (
              <li class="flex items-start gap-3">
                <svg
                  class="mt-0.5 h-5 w-5 shrink-0 text-[var(--color-oliva)]"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2.5"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                <span class="text-[16px] leading-relaxed text-[var(--color-carbon)]/85">{item}</span>
              </li>
            ))
          }
        </ul>

        <a
          href={mailto}
          class="group mt-9 flex w-full items-center justify-center gap-3 rounded-full bg-[var(--color-oliva)] px-8 py-4.5 text-base font-black text-white shadow-xl shadow-[var(--color-oliva)]/25 transition-all duration-300 hover:-translate-y-1 hover:bg-[var(--color-bosque)]"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
          </svg>
          Solicitar cotización por correo
        </a>
        <p class="mt-4 text-center text-sm text-[var(--color-carbon)]/60">
          Se abrirá tu correo hacia
          <span class="font-bold text-[var(--color-bosque)]">{email}</span>
        </p>
      </div>
    </div>
  </div>
</section>
